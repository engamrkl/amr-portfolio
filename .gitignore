<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Amr Khaled Gaissah – Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800&family=Cairo:wght@400;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F7F3E8; --ink:#0B1430; --muted:#55607A; --line:#D8CFB5; --accent:#8A6508;
  --navy:#0B1430; --gold:#E8C25A; --cream:#F4EEDC;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#0A1022;--ink:#F4EEDC;--muted:#A5AEC4;--line:#26304D;--accent:#E8C25A}
}
:root[data-theme="dark"]{--bg:#0A1022;--ink:#F4EEDC;--muted:#A5AEC4;--line:#26304D;--accent:#E8C25A}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Bricolage Grotesque","Cairo",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:1.0625rem;line-height:1.55}
a{color:inherit}
a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.wrap{max-width:46rem;margin:0 auto;padding:0 1.25rem}
.banner{display:block;width:100%;height:auto;background:var(--navy)}
.why p{max-width:36rem;margin:0 0 1rem}
.poster{display:block;width:100%;height:auto;margin-top:1.5rem;border-radius:.5rem}
.hero{background:var(--navy);color:var(--cream);padding:2.25rem 0 2rem;border-bottom:3px solid var(--gold)}
.hero h1{font-size:clamp(2.1rem,9vw,3.5rem);line-height:1;letter-spacing:-.03em;font-weight:800;margin:0 0 1rem;color:var(--gold)}
.hero p{font-size:1.25rem;max-width:30rem;margin:0}